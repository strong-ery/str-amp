-#define DFXG_REGISTRY_DFX_PRODUCT_NAME_WIDE		L"DFX"
+/*
+ * str-amp: was L"DFX". The registry product name is the top of the tree this library
+ * keeps its live settings in, HKCU\SOFTWARE\<name>\<major>\<vendor>. Left as "DFX"
+ * that is the very tree an installed FxSound is using, so str-amp would read that
+ * install's settings at startup and write its own back over them. Renaming gives
+ * str-amp its own tree and leaves a side-by-side FxSound install untouched.
+ */
+#define DFXG_REGISTRY_DFX_PRODUCT_NAME_WIDE		L"StrAmp"
 #define DFXG_DISPLAYED_DFX_PRODUCT_NAME_WIDE    L"FxSound"
