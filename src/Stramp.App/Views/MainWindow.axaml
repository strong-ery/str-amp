<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stramp.App.ViewModels"
        xmlns:conv="using:Stramp.App.Converters"
        xmlns:app="using:Stramp.App"
        xmlns:controls="using:Stramp.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
        x:Class="Stramp.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Root"
        Icon="/Assets/avalonia-logo.ico"
        Title="stramp"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Width="980" Height="640">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:NullToBoolConverter x:Key="NullToBool" />
        <conv:PlayPauseIconConverter x:Key="PlayPauseIcon" />
        <conv:BoolToLibraryWidthConverter x:Key="LibraryWidth" />
        <conv:BoolToLibraryMarginConverter x:Key="LibraryMargin" />
        <conv:BoolToOpacityConverter x:Key="EnabledOpacity" />

        <DataTemplate x:Key="ColorEditorTemplate" x:DataType="vm:ColorChannelEditor">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <controls:ColorPicker Grid.Column="0" Height="104" Color="{Binding Color, Mode=TwoWay}" />
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top" Width="96">
                    <Border Classes="swatch" Width="96" Height="42" Background="{Binding PreviewBrush}" />
                    <TextBox Text="{Binding Hex}" FontSize="12" Padding="7,3" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Panel>
        <DockPanel>
            <!-- Custom title bar (all system chrome is off) -->
            <Grid DockPanel.Dock="Top" Height="34" ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                <Menu Grid.Column="0" VerticalAlignment="Center" Margin="6,0,0,0">
                    <MenuItem Header="stramp">
                        <MenuItem Header="Layout">
                            <MenuItem Header="Equalize Side Panels" Command="{Binding EqualizeSidePanelsCommand}" />
                            <MenuItem Header="Toggle Library Panel" Command="{Binding ToggleLibraryOpenCommand}" />
                        </MenuItem>
                        <MenuItem Header="Styling">
                            <MenuItem Header="Theme…" Command="{Binding OpenSettingsCommand}" />
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <Border Grid.Column="1" Background="Transparent"
                        PointerPressed="OnTitleBarPointerPressed" DoubleTapped="OnTitleBarDoubleTapped">
                    <TextBlock Text="stramp" FontSize="12" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Classes="window-button" Click="OnMinimizeClicked" ToolTip.Tip="Minimize">
                        <PathIcon Data="{x:Static app:Icons.WindowMinimize}" />
                    </Button>
                    <Button Classes="window-button" Click="OnMaximizeClicked" ToolTip.Tip="Maximize">
                        <PathIcon x:Name="MaximizeIcon" Data="{x:Static app:Icons.WindowMaximize}" />
                    </Button>
                    <Button Classes="window-button close" Click="OnCloseClicked" ToolTip.Tip="Close">
                        <PathIcon Data="{x:Static app:Icons.WindowClose}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="MainContentGrid" Margin="16,6,16,16" RowDefinitions="Auto,*">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="0" MaxWidth="600" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" MinWidth="160" MaxWidth="600" />
                </Grid.ColumnDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,0,0,12">
                    <Button Classes="transport" Command="{Binding ToggleLibraryOpenCommand}"
                            ToolTip.Tip="Show/hide library" DockPanel.Dock="Left" Margin="0,0,8,0">
                        <PathIcon Data="{x:Static app:Icons.Menu}" Width="18" Height="18" />
                    </Button>
                    <Button Classes="transport" Command="{Binding EqualizeSidePanelsCommand}"
                            ToolTip.Tip="Equalize side panel widths" DockPanel.Dock="Left" Margin="0,0,8,0">
                        <PathIcon Data="{x:Static app:Icons.EqualizePanels}" Width="17" Height="17" />
                    </Button>
                    <Button Classes="transport" Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Settings" DockPanel.Dock="Left" Margin="0,0,10,0">
                        <PathIcon Data="{x:Static app:Icons.Settings}" Width="17" Height="17" />
                    </Button>
                    <Button Click="OnOpenLibraryClicked" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{x:Static app:Icons.FolderOpen}" Width="16" Height="16" />
                            <TextBlock Text="Open Library…" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnImportPlaylistClicked" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{x:Static app:Icons.Playlist}" Width="16" Height="16" />
                            <TextBlock Text="Import Playlist…" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding StatusText}" Foreground="OrangeRed" Margin="4,0,0,0"
                               VerticalAlignment="Center" />
                </DockPanel>

                <!-- Library (collapsible): source menu, then the song list for the chosen source -->
                <Border x:Name="LibraryBorder" Grid.Row="1" Grid.Column="0" ClipToBounds="True" HorizontalAlignment="Stretch">
                    <DockPanel HorizontalAlignment="Stretch">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                            <Button Grid.Column="0" Classes="transport" Width="24" Height="24" Padding="3"
                                    Margin="0,0,6,0" IsVisible="{Binding !IsBrowsingSources}"
                                    Command="{Binding BackToSourcesCommand}" ToolTip.Tip="Back to playlists">
                                <PathIcon Data="{x:Static app:Icons.Back}" Width="12" Height="12" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding LibraryHeaderText}" Classes="section-header"
                                       VerticalAlignment="Center" Margin="0" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <TextBox Text="{Binding SearchText}" PlaceholderText="Search…" DockPanel.Dock="Top"
                                 Margin="0,0,0,8" IsVisible="{Binding !IsBrowsingSources}">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{x:Static app:Icons.Search}" Width="14" Height="14" Opacity="0.6" Margin="8,0,0,0" />
                            </TextBox.InnerLeftContent>
                        </TextBox>

                        <Grid RowDefinitions="*">
                            <!-- Source menu: All Songs first, then playlists -->
                            <ListBox x:Name="SourceList" Grid.Row="0" Classes="flat-list"
                                     ItemsSource="{Binding LibrarySources}"
                                     IsVisible="{Binding IsBrowsingSources}" Tapped="OnSourceTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LibrarySourceRow">
                                        <Border Classes="queue-row">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <PathIcon Grid.Column="0" Width="16" Height="16" Opacity="0.7"
                                                          VerticalAlignment="Center"
                                                          Data="{x:Static app:Icons.Playlist}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Classes="queue-title"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CountText}" FontSize="11" Opacity="0.55" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Songs of the selected source -->
                            <ListBox x:Name="LibraryList" Grid.Row="0" Classes="flat-list"
                                     ItemsSource="{Binding LibraryRows}"
                                     IsVisible="{Binding !IsBrowsingSources}" Tapped="OnLibraryTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SongRow">
                                        <Border Classes="queue-row" Classes.playing="{Binding IsCurrent}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border Grid.Column="0" Classes="art-frame" Width="40" Height="40">
                                                    <Grid>
                                                        <PathIcon Data="{x:Static app:Icons.MusicNote}" Width="18" Height="18" Opacity="0.35"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  IsVisible="{Binding ArtBitmap, Converter={StaticResource NullToBool}, ConverterParameter=invert}" />
                                                        <Image Source="{Binding ArtBitmap}" Stretch="UniformToFill"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality"
                                                               IsVisible="{Binding ArtBitmap, Converter={StaticResource NullToBool}}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Classes="queue-title" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Left Splitter -->
                <GridSplitter x:Name="LeftSplitter" Grid.Row="1" Grid.Column="1"
                              Width="8" Margin="1,0" Background="Transparent"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              IsVisible="{Binding IsLibraryOpen}">
                    <GridSplitter.Template>
                        <ControlTemplate>
                            <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Border Width="2" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                        Background="{DynamicResource AppIconBrush}" Opacity="0.15" />
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- Player -->
                <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="*,Auto,Auto,Auto,Auto" Margin="10,0">
                    <Border x:Name="NowPlayingCard" Grid.Row="0" Classes="now-playing-card" ClipToBounds="True"
                            SizeChanged="OnViewportSizeChanged">
                        <Grid>
                            <!-- Fills the card and shares its center with the album art, so the ring
                                 stays concentric with the artwork at any window size. -->
                            <controls:SpectrumVisualizerControl x:Name="Visualizer"
                                PrimaryBrush="{DynamicResource AppAccentBrush}"
                                SecondaryBrush="{DynamicResource AppSecondaryAccentBrush}"
                                ShowRing="{Binding Theme.ShowRingVisualizer}"
                                ShowSkyline="{Binding Theme.ShowBottomVisualizer}"
                                SkylineOpacity="{Binding Theme.BottomVisualizerOpacity}"
                                InnerRadius="128" />

                            <Border x:Name="ArtFrame" Classes="art-frame" Width="200" Height="200"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid>
                                    <PathIcon Data="{x:Static app:Icons.MusicNote}" Width="56" Height="56" Opacity="0.35"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsVisible="{Binding CurrentArtBitmap, Converter={StaticResource NullToBool}, ConverterParameter=invert}" />
                                    <Image Source="{Binding CurrentArtBitmap}" Stretch="UniformToFill"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                           IsVisible="{Binding CurrentArtBitmap, Converter={StaticResource NullToBool}}" />
                                </Grid>
                            </Border>

                            <StackPanel Spacing="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Margin="0,0,0,18">
                                <TextBlock Text="{Binding CurrentTitle}" FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                           MaxWidth="320" />
                                <TextBlock Text="{Binding CurrentArtist}" FontSize="13" Opacity="0.7"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding ElapsedText}" VerticalAlignment="Center" Width="42" FontSize="12" Opacity="0.7" />
                        <Panel Grid.Column="1">
                            <controls:WaveformSeekBar x:Name="WaveformBar" Height="38"
                                IsVisible="{Binding Theme.ShowWaveformProgress}"
                                Progress="{Binding ProgressFraction}"
                                PlayedBrush="{DynamicResource AppAccentBrush}"
                                RemainingBrush="{DynamicResource AppIconBrush}" />
                            <Slider x:Name="ProgressSlider" IsVisible="{Binding !Theme.ShowWaveformProgress}"
                                    Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding ProgressSeconds}" />
                        </Panel>
                        <TextBlock Grid.Column="2" Text="{Binding TotalText}" VerticalAlignment="Center" Width="42"
                                   TextAlignment="Right" FontSize="12" Opacity="0.7" />
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"
                                Margin="0,16,0,0">
                        <Button Classes="transport" Classes.active="{Binding Shuffled}" Command="{Binding ToggleShuffleCommand}"
                                ToolTip.Tip="Shuffle">
                            <PathIcon Data="{x:Static app:Icons.Shuffle}" Width="18" Height="18" />
                        </Button>
                        <Button Classes="transport" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous">
                            <PathIcon Data="{x:Static app:Icons.SkipPrevious}" Width="20" Height="20" />
                        </Button>
                        <Button Classes="play-pause" Command="{Binding PlayPauseCommand}">
                            <PathIcon Data="{Binding IsPlaying, Converter={StaticResource PlayPauseIcon}}" Width="24" Height="24" />
                        </Button>
                        <Button Classes="transport" Command="{Binding NextCommand}" ToolTip.Tip="Next">
                            <PathIcon Data="{x:Static app:Icons.SkipNext}" Width="20" Height="20" />
                        </Button>
                        <Button Classes="transport" Command="{Binding ReshuffleCommand}" ToolTip.Tip="Reshuffle remaining">
                            <PathIcon Data="{x:Static app:Icons.Refresh}" Width="18" Height="18" />
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,16,0,0">
                        <PathIcon Grid.Column="0" Data="{x:Static app:Icons.VolumeHigh}" Width="16" Height="16" Opacity="0.7"
                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume}" />
                    </Grid>
                </Grid>

                <!-- Right Splitter -->
                <GridSplitter x:Name="RightSplitter" Grid.Row="1" Grid.Column="3"
                              Width="8" Margin="1,0" Background="Transparent"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              HorizontalAlignment="Center" VerticalAlignment="Stretch">
                    <GridSplitter.Template>
                        <ControlTemplate>
                            <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Border Width="2" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                        Background="{DynamicResource AppIconBrush}" Opacity="0.15" />
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- Queue sidebar -->
                <DockPanel Grid.Row="1" Grid.Column="4" Margin="10,0,0,0">
                    <TextBlock Text="UP NEXT" Classes="section-header" DockPanel.Dock="Top" />
                    <ListBox x:Name="QueueList" Classes="flat-list" ItemsSource="{Binding QueueRows}" Tapped="OnQueueTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SongRow">
                                <Border Classes="queue-row" Classes.playing="{Binding IsCurrent}" ToolTip.Tip="Right-click to remove from queue">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Remove from queue"
                                                      Command="{Binding #Root.DataContext.RemoveFromQueueCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{x:Static app:Icons.Delete}" Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <!-- Grid rather than a StackPanel: a horizontal StackPanel hands children
                                         infinite width, so ellipsising kicks in far too early. -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Grid.Column="0" Classes="art-frame" Width="40" Height="40">
                                            <Grid>
                                                <PathIcon Data="{x:Static app:Icons.MusicNote}" Width="18" Height="18" Opacity="0.35"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsVisible="{Binding ArtBitmap, Converter={StaticResource NullToBool}, ConverterParameter=invert}" />
                                                <Image Source="{Binding ArtBitmap}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                       IsVisible="{Binding ArtBitmap, Converter={StaticResource NullToBool}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Classes="queue-title" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </DockPanel>

        <!-- Resize grips (we draw our own chrome, so the system border is gone) -->
        <Grid x:Name="ResizeGrips" RowDefinitions="5,*,5" ColumnDefinitions="5,*,5">
            <Border Grid.Row="0" Grid.Column="0" Background="Transparent" Cursor="TopLeftCorner"
                    Tag="NorthWest" PointerPressed="OnResizePressed" />
            <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Cursor="TopSide"
                    Tag="North" PointerPressed="OnResizePressed" />
            <Border Grid.Row="0" Grid.Column="2" Background="Transparent" Cursor="TopRightCorner"
                    Tag="NorthEast" PointerPressed="OnResizePressed" />
            <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Cursor="LeftSide"
                    Tag="West" PointerPressed="OnResizePressed" />
            <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Cursor="RightSide"
                    Tag="East" PointerPressed="OnResizePressed" />
            <Border Grid.Row="2" Grid.Column="0" Background="Transparent" Cursor="BottomLeftCorner"
                    Tag="SouthWest" PointerPressed="OnResizePressed" />
            <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Cursor="BottomSide"
                    Tag="South" PointerPressed="OnResizePressed" />
            <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Cursor="BottomRightCorner"
                    Tag="SouthEast" PointerPressed="OnResizePressed" />
        </Grid>

        <!-- In-app settings dialog -->
        <Border x:Name="SettingsScrim" Classes="dialog-scrim" IsVisible="{Binding IsSettingsOpen}"
                PointerPressed="OnScrimPressed">
            <Border Classes="dialog-card" Width="560" MaxHeight="660"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel Margin="22">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Settings" Classes="dialog-title" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="transport" Width="30" Height="30" Padding="6"
                                Command="{Binding CloseSettingsCommand}">
                            <PathIcon Data="{x:Static app:Icons.WindowClose}" Width="11" Height="11" />
                        </Button>
                    </Grid>

                    <Button DockPanel.Dock="Bottom" Content="Reset to defaults"
                            Command="{Binding Theme.ResetToDefaultsCommand}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" />

                    <ScrollViewer>
                        <StackPanel Spacing="18">
                            <TextBlock Text="VISUALS" Classes="section-header" Margin="0,8,0,0" />

                            <StackPanel Spacing="10">
                                <ToggleSwitch IsChecked="{Binding Theme.ShowRingVisualizer}"
                                              OnContent="Central visualizer" OffContent="Central visualizer" />
                                <ToggleSwitch IsChecked="{Binding Theme.ShowBottomVisualizer}"
                                              OnContent="Bottom visualizer" OffContent="Bottom visualizer" />
                                <StackPanel Spacing="4" IsEnabled="{Binding Theme.ShowBottomVisualizer}"
                                            Opacity="{Binding Theme.ShowBottomVisualizer, Converter={StaticResource EnabledOpacity}}">
                                    <TextBlock Text="Bottom visualizer opacity" Classes="field-label" />
                                    <Slider Minimum="0" Maximum="1" Value="{Binding Theme.BottomVisualizerOpacity}" />
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding Theme.AnimateAlbumArt}"
                                              OnContent="Album art animation" OffContent="Album art animation" />
                                <ToggleSwitch IsChecked="{Binding Theme.ShowWaveformProgress}"
                                              OnContent="Waveform progress bar" OffContent="Waveform progress bar" />
                            </StackPanel>

                            <TextBlock Text="EQUALIZER" Classes="section-header" Margin="0,6,0,0" />

                            <StackPanel Spacing="10">
                                <ToggleSwitch IsChecked="{Binding Theme.EqualizerEnabled}"
                                              OnContent="Equalizer enabled" OffContent="Equalizer enabled" />

                                <Border Classes="eq-panel" IsEnabled="{Binding Theme.EqualizerEnabled}"
                                        Opacity="{Binding Theme.EqualizerEnabled, Converter={StaticResource EnabledOpacity}}">
                                    <StackPanel Spacing="6">
                                        <ItemsControl ItemsSource="{Binding Theme.EqualizerBands}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EqualizerBandViewModel">
                                                    <StackPanel Spacing="4" Width="44">
                                                        <Slider Orientation="Vertical" Height="110"
                                                                Minimum="-20" Maximum="20"
                                                                Value="{Binding Gain}"
                                                                HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Label}" FontSize="10" Opacity="0.6"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="Flatten" Command="{Binding Theme.ResetEqualizerCommand}"
                                                HorizontalAlignment="Center" FontSize="12" Padding="10,4" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="THEME" Classes="section-header" Margin="0,6,0,0" />

                            <StackPanel Spacing="6">
                                <ToggleSwitch IsChecked="{Binding Theme.DeriveFromArt}"
                                              OnContent="Match colors to album art"
                                              OffContent="Match colors to album art" />
                                <TextBlock Classes="field-hint"
                                           Text="Accent and background colors follow the artwork of whatever's playing. Turn this off to pick your own." />
                            </StackPanel>

                            <StackPanel Spacing="8" IsEnabled="{Binding !Theme.DeriveFromArt}"
                                        Opacity="{Binding !Theme.DeriveFromArt, Converter={StaticResource EnabledOpacity}}">
                                <TextBlock Text="Presets" Classes="field-label" />
                                <ItemsControl ItemsSource="{Binding Theme.Presets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ThemePreset">
                                            <Button Classes="preset" Margin="0,0,8,8"
                                                    Command="{Binding #Root.DataContext.Theme.ApplyPresetCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Border Width="13" Height="13" CornerRadius="7"
                                                            Background="{Binding PrimaryBrush}" VerticalAlignment="Center" />
                                                    <Border Width="13" Height="13" CornerRadius="7"
                                                            Background="{Binding SecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Primary accent" Classes="field-label" />
                                    <ContentControl Content="{Binding Theme.Primary}"
                                                    ContentTemplate="{StaticResource ColorEditorTemplate}" />
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Secondary accent" Classes="field-label" />
                                    <ContentControl Content="{Binding Theme.Secondary}"
                                                    ContentTemplate="{StaticResource ColorEditorTemplate}" />
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Background" Classes="field-label" />
                                    <ContentControl Content="{Binding Theme.Background}"
                                                    ContentTemplate="{StaticResource ColorEditorTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Panel>
</Window>
