<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stramp.App.ViewModels"
        xmlns:conv="using:Stramp.App.Converters"
        xmlns:app="using:Stramp.App"
        xmlns:controls="using:Stramp.App.Controls"
        xmlns:playback="using:Stramp.Core.Playback"
        xmlns:theming="using:Stramp.App.Theming"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
        x:Class="Stramp.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Root"
        Icon="/Assets/Stramp.ico"
        Title="stramp"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Width="980" Height="640"
        MinWidth="680" MinHeight="480"
        DragDrop.AllowDrop="True">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:NullToBoolConverter x:Key="NullToBool" />
        <conv:PlayPauseIconConverter x:Key="PlayPauseIcon" />
        <conv:BoolToLibraryWidthConverter x:Key="LibraryWidth" />
        <conv:BoolToLibraryMarginConverter x:Key="LibraryMargin" />
        <conv:BoolToOpacityConverter x:Key="EnabledOpacity" />
        <conv:BoolToFadeOpacityConverter x:Key="FadeOpacity" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />

        <DataTemplate x:Key="ColorEditorTemplate" x:DataType="vm:ColorChannelEditor">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <controls:ColorPicker Grid.Column="0" Height="104" Color="{Binding Color, Mode=TwoWay}" />
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top" Width="96">
                    <Border Classes="swatch" Width="96" Height="42" Background="{Binding PreviewBrush}" />
                    <TextBox Text="{Binding Hex}" FontSize="12" Padding="7,3" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TopTrackTemplate" x:DataType="vm:TopTrackRow">
            <Border Classes="library-location-row">
                <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="11">
                    <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="12" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" Classes="field-hint" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlayCountLabel}" FontSize="11" Opacity="0.8"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding FormattedTime}" Classes="field-hint" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TopArtistTemplate" x:DataType="vm:TopArtistRow">
            <Border Classes="library-location-row">
                <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="11">
                    <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="12" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Artist}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlayCountLabel}" FontSize="11" Opacity="0.8"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding FormattedTime}" Classes="field-hint" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Panel>
        <DockPanel>
            <!-- Custom title bar (all system chrome is off) -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="34" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Spacing="12">
                    <Button Classes="top-menu-trigger" Content="stramp" VerticalAlignment="Center">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft"
                                        FlyoutPresenterClasses="stramp-menu-flyout">
                                <MenuItem Header="Toggle Fullscreen" Classes="stramp-menu-item"
                                          Click="OnToggleFullScreenClicked" InputGesture="F11">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static app:Icons.FullScreen}" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Equalize Side Panels" Classes="stramp-menu-item"
                                          Command="{Binding EqualizeSidePanelsCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static app:Icons.EqualizePanels}" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Margin="7,4" />
                                <MenuItem Header="Add Library Folder…" Classes="stramp-menu-item"
                                          Click="OnOpenLibraryClicked">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static app:Icons.FolderOpen}" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="New Playlist…" Classes="stramp-menu-item"
                                          Command="{Binding OpenNewPlaylistDialogCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static app:Icons.Add}" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Import Playlist…" Classes="stramp-menu-item"
                                          Click="OnImportPlaylistClicked">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static app:Icons.Playlist}" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="View Stats…" Classes="stramp-menu-item"
                                          Command="{Binding OpenStatsCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static app:Icons.BarChart}" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Margin="7,4" />
                                <MenuItem Header="Settings…" Classes="stramp-menu-item"
                                          Command="{Binding OpenSettingsCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{x:Static app:Icons.Settings}" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Border Grid.Column="1" Background="Transparent"
                        PointerPressed="OnTitleBarPointerPressed" DoubleTapped="OnTitleBarDoubleTapped">
                    <TextBlock Text="stramp" FontSize="12" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Classes="window-button" Click="OnMinimizeClicked" ToolTip.Tip="Minimize">
                        <PathIcon Data="{x:Static app:Icons.WindowMinimize}" />
                    </Button>
                    <Button Classes="window-button" Click="OnMaximizeClicked" ToolTip.Tip="Maximize">
                        <PathIcon x:Name="MaximizeIcon" Data="{x:Static app:Icons.WindowMaximize}" />
                    </Button>
                    <Button Classes="window-button close" Click="OnCloseClicked" ToolTip.Tip="Close">
                        <PathIcon Data="{x:Static app:Icons.WindowClose}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="MainContentGrid" Margin="16,6,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="0" MaxWidth="600" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" MinWidth="0" MaxWidth="600" />
                </Grid.ColumnDefinitions>

                <!-- Library (collapsible): source menu, then the song list for the chosen source -->
                <Border x:Name="LibraryBorder" Grid.Column="0" ClipToBounds="True" HorizontalAlignment="Stretch">
                    <DockPanel HorizontalAlignment="Stretch">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
                            <Button Grid.Column="0" Classes="transport" Width="24" Height="24" Padding="3"
                                    Margin="0,0,6,0" IsVisible="{Binding !IsBrowsingSources}"
                                    Command="{Binding BackToSourcesCommand}" ToolTip.Tip="Back to playlists">
                                <PathIcon Data="{x:Static app:Icons.Back}" Width="12" Height="12" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding LibraryHeaderText}" Classes="section-header"
                                       VerticalAlignment="Center" Margin="0" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Classes="transport" Width="24" Height="24" Padding="3" Margin="0,0,4,0"
                                    IsVisible="{Binding IsBrowsingSources}"
                                    Command="{Binding OpenNewPlaylistDialogCommand}" ToolTip.Tip="Create new playlist">
                                <PathIcon Data="{x:Static app:Icons.Add}" Width="13" Height="13" />
                            </Button>
                            <Button Grid.Column="3" Classes="transport" Width="24" Height="24" Padding="3"
                                    Command="{Binding ToggleLibraryOpenCommand}" ToolTip.Tip="Collapse library">
                                <PathIcon Data="{x:Static app:Icons.PanelLeft}" Width="14" Height="14" />
                            </Button>
                        </Grid>

                        <!-- Search & Sort Bar -->
                        <Grid DockPanel.Dock="Top" RowDefinitions="Auto,Auto" Margin="0,0,0,8" IsVisible="{Binding !IsBrowsingSources}">
                            <TextBox Grid.Row="0" Text="{Binding SearchText}" PlaceholderText="Search…"
                                     Classes="stramp-input" Margin="0,0,0,6">
                                <TextBox.InnerLeftContent>
                                    <PathIcon Data="{x:Static app:Icons.Search}" Width="12" Height="12" Opacity="0.55" Margin="8,0,2,0" />
                                </TextBox.InnerLeftContent>
                            </TextBox>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Sort:" FontSize="11" FontWeight="SemiBold" Opacity="0.55"
                                           VerticalAlignment="Center" Margin="2,0,6,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableSortOptions}" SelectedItem="{Binding SelectedSortOption}"
                                          Classes="stramp-combo" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SortOptionRow">
                                            <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Grid>

                        <Grid RowDefinitions="*">
                            <!-- Source menu: All Songs, then each library folder, then playlists -->
                            <ListBox x:Name="SourceList" Grid.Row="0" Classes="flat-list library-scroll"
                                     ItemsSource="{Binding LibrarySources}"
                                     IsVisible="{Binding IsBrowsingSources}" Tapped="OnSourceTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LibrarySourceRow">
                                        <Border Classes="queue-row">
                                            <Border.ContextMenu>
                                                <ContextMenu IsVisible="{Binding IsPlaylist}">
                                                    <MenuItem Header="Export to .m3u8…" Click="OnExportPlaylistSourceRowClicked">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{x:Static app:Icons.Playlist}" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Delete playlist"
                                                              Command="{Binding #Root.DataContext.DeletePlaylistCommand}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{x:Static app:Icons.Delete}" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <PathIcon Grid.Column="0" Width="16" Height="16" Opacity="0.7"
                                                          VerticalAlignment="Center"
                                                          Data="{Binding Icon}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Classes="queue-title"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CountText}" FontSize="11" Opacity="0.55" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Songs of the selected source -->
                            <ListBox x:Name="LibraryList" Grid.Row="0" Classes="flat-list library-scroll"
                                     ItemsSource="{Binding LibraryRows}"
                                     SelectedItem="{Binding SelectedLibraryRow, Mode=TwoWay}"
                                     ContainerPrepared="OnSongContainerPrepared"
                                     ContainerClearing="OnSongContainerClearing"
                                     IsVisible="{Binding !IsBrowsingSources}" Tapped="OnLibraryTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SongRow">
                                        <Border Classes="queue-row" Classes.playing="{Binding IsCurrent}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Move up"
                                                              InputGesture="Alt+Up"
                                                              Command="{Binding #Root.DataContext.MoveSongInPlaylistUpCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsVisible="{Binding #Root.DataContext.IsViewingPlaylist}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{x:Static app:Icons.ChevronUp}" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Move down"
                                                              InputGesture="Alt+Down"
                                                              Command="{Binding #Root.DataContext.MoveSongInPlaylistDownCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsVisible="{Binding #Root.DataContext.IsViewingPlaylist}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{x:Static app:Icons.ChevronDown}" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Move to top"
                                                              Command="{Binding #Root.DataContext.MoveSongInPlaylistToTopCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsVisible="{Binding #Root.DataContext.IsViewingPlaylist}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{x:Static app:Icons.ChevronDoubleUp}" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Move to bottom"
                                                              Command="{Binding #Root.DataContext.MoveSongInPlaylistToBottomCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsVisible="{Binding #Root.DataContext.IsViewingPlaylist}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{x:Static app:Icons.ChevronDoubleDown}" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator IsVisible="{Binding #Root.DataContext.IsViewingPlaylist}" />
                                                    <MenuItem Header="Add to playlist…"
                                                              Command="{Binding #Root.DataContext.OpenAddToPlaylistForSongCommand}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{x:Static app:Icons.PlaylistAdd}" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Remove from this playlist"
                                                              InputGesture="Delete"
                                                              Command="{Binding #Root.DataContext.RemoveSongFromCurrentPlaylistCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsVisible="{Binding #Root.DataContext.IsViewingPlaylist}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{x:Static app:Icons.Delete}" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Remove song (permanent)…"
                                                              Command="{Binding #Root.DataContext.RequestDeleteSongPermanentlyCommand}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{x:Static app:Icons.Delete}" Width="14" Height="14" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border Grid.Column="0" Classes="art-frame" Width="40" Height="40">
                                                    <Grid>
                                                        <PathIcon Data="{x:Static app:Icons.MusicNote}" Width="18" Height="18" Opacity="0.35"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  IsVisible="{Binding ArtBitmap, Converter={StaticResource NullToBool}, ConverterParameter=invert}" />
                                                        <Image Source="{Binding ArtBitmap}" Stretch="UniformToFill"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality"
                                                               IsVisible="{Binding ArtBitmap, Converter={StaticResource NullToBool}}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Classes="queue-title" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Left Splitter -->
                <GridSplitter x:Name="LeftSplitter" Grid.Column="1"
                              Width="8" Margin="1,0" Background="Transparent"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              IsVisible="{Binding IsLibraryOpen}">
                    <GridSplitter.Template>
                        <ControlTemplate>
                            <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Border Width="2" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                        Background="{DynamicResource AppIconBrush}" Opacity="0.15" />
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- Player -->
                <Grid Grid.Column="2" RowDefinitions="*,Auto,Auto" Margin="10,0">
                    <Border x:Name="NowPlayingCard" Grid.Row="0" Classes="now-playing-card" ClipToBounds="True"
                            SizeChanged="OnViewportSizeChanged">
                        <Grid>
                            <!-- Opening lyrics gives the right column a star width (see UpdateLyricsSplit),
                                 which squeezes the stage into the left half without moving anything else. -->
                            <Grid x:Name="NowPlayingSplit" ColumnDefinitions="*,0">
                                <!-- Cover, ring and track name, centered on whatever width is left over. -->
                                <Grid x:Name="NowPlayingStage" Grid.Column="0" ClipToBounds="True"
                                      SizeChanged="OnStageSizeChanged">
                                    <!-- Fills the stage and shares its center with the album art, so the ring
                                         stays concentric with the artwork at any window size. -->
                                    <controls:SpectrumVisualizerControl x:Name="Visualizer"
                                        PrimaryBrush="{DynamicResource AppAccentBrush}"
                                        SecondaryBrush="{DynamicResource AppSecondaryAccentBrush}"
                                        ShowRing="{Binding Theme.ShowRingVisualizer}"
                                        ShowSkyline="{Binding Theme.ShowBottomVisualizer}"
                                        SkylineOpacity="{Binding Theme.BottomVisualizerOpacity}"
                                        InnerRadius="142" />

                                    <Border x:Name="ArtFrame" Classes="art-frame" Classes.circular="{Binding Theme.CircularAlbumArt}"
                                            Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid>
                                            <PathIcon Data="{x:Static app:Icons.MusicNote}" Width="56" Height="56" Opacity="0.35"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsVisible="{Binding CurrentArtBitmap, Converter={StaticResource NullToBool}, ConverterParameter=invert}" />
                                            <Image Source="{Binding CurrentArtBitmap}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                                   IsVisible="{Binding CurrentArtBitmap, Converter={StaticResource NullToBool}}" />
                                        </Grid>
                                    </Border>

                                    <!-- The margin plus MaxWidth is what the title wraps against, so it keeps
                                         inside the stage once the lyrics panel has taken half the card. -->
                                    <StackPanel Spacing="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                MaxWidth="320" Margin="12,0,12,18">
                                        <TextBlock Text="{Binding CurrentTitle}" FontSize="20" FontWeight="Bold"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentArtist}" FontSize="13" Opacity="0.7"
                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                 <!-- Lyrics half -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="6,14,16,14" ClipToBounds="True"
                                      IsVisible="{Binding IsLyricsOpen}">
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="LYRICS" Classes="section-header" Margin="0" />
                                            <!-- Says whether these came off disk or lrclib.net, and
                                                 whether they will follow along or just sit there. -->
                                            <TextBlock Text="{Binding LyricsSourceText}" FontSize="10" Opacity="0.4"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding HasLyrics}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding LyricsStatusText}"
                                               IsVisible="{Binding !HasLyrics}"
                                               FontSize="12" Opacity="0.45" MaxWidth="220"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- Unsynced files get the same list, minus the highlight and the seeking. -->
                                    <ScrollViewer x:Name="LyricsScroller" Grid.Row="1" Classes="lyrics-scroll"
                                                  IsVisible="{Binding HasLyrics}"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  PointerMoved="OnLyricsPointerMoved"
                                                  PointerExited="OnLyricsPointerExited"
                                                  PointerReleased="OnLyricsPointerReleased"
                                                  PointerCaptureLost="OnLyricsPointerCaptureLost"
                                                  SizeChanged="OnLyricsViewportSizeChanged">
                                        <ItemsControl x:Name="LyricsItems" ItemsSource="{Binding LyricLines}"
                                                      Tapped="OnLyricTapped">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LyricLineRow">
                                                    <Border Classes="lyric-line"
                                                            Classes.active="{Binding IsActive}"
                                                            Classes.past="{Binding IsPast}"
                                                            Classes.plain="{Binding !IsSeekable}">
                                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"
                                                                   FontSize="{Binding #LyricsItems.FontSize}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <!-- Small corner buttons to reopen collapsed panels. Outside the split so they
                                 stay pinned to the card's corners rather than the stage's. -->
                            <Button Classes="transport" Width="28" Height="28" Padding="5" Margin="10"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Command="{Binding ToggleLibraryOpenCommand}"
                                    IsVisible="{Binding !IsLibraryOpen}"
                                    ToolTip.Tip="Open library">
                                <PathIcon Data="{x:Static app:Icons.PanelLeft}" Width="14" Height="14" Opacity="0.7" />
                            </Button>
                            <Button Classes="transport" Width="28" Height="28" Padding="5" Margin="10"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding ToggleUpNextOpenCommand}"
                                    IsVisible="{Binding !IsUpNextOpen}"
                                    ToolTip.Tip="Open Up Next">
                                <PathIcon Data="{x:Static app:Icons.PanelRight}" Width="14" Height="14" Opacity="0.7" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding ElapsedText}" VerticalAlignment="Center" Width="42" FontSize="12" Opacity="0.7" />
                        <Panel Grid.Column="1">
                            <controls:WaveformSeekBar x:Name="WaveformBar" Height="38"
                                IsVisible="{Binding Theme.ShowWaveformProgress}"
                                Progress="{Binding ProgressFraction}"
                                Duration="{Binding DurationSeconds}"
                                PlayedBrush="{DynamicResource AppAccentBrush}"
                                RemainingBrush="{DynamicResource AppIconBrush}" />
                            <Slider x:Name="ProgressSlider" IsVisible="{Binding !Theme.ShowWaveformProgress}"
                                    Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding ProgressSeconds}" />
                        </Panel>
                        <TextBlock Grid.Column="2" Text="{Binding TotalText}" VerticalAlignment="Center" Width="42"
                                   TextAlignment="Right" FontSize="12" Opacity="0.7" />
                    </Grid>

                    <!-- Normal Control Bar (Volume on the right side) when there is enough room -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" Margin="0,16,0,0"
                          IsVisible="{Binding !IsCompactControlBar}">
                        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Button Classes="transport" Classes.active="{Binding Shuffled}" Command="{Binding ToggleShuffleCommand}"
                                    ToolTip.Tip="Shuffle">
                                <PathIcon Data="{x:Static app:Icons.Shuffle}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="transport" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous">
                                <PathIcon Data="{x:Static app:Icons.SkipPrevious}" Width="20" Height="20" />
                            </Button>
                            <Button Classes="play-pause" Command="{Binding PlayPauseCommand}">
                                <Grid Width="24" Height="24">
                                    <PathIcon Data="{x:Static app:Icons.Play}" Width="24" Height="24"
                                              IsVisible="{Binding !IsPlaying}">
                                        <PathIcon.RenderTransform>
                                            <TranslateTransform X="1.5" />
                                        </PathIcon.RenderTransform>
                                    </PathIcon>
                                    <PathIcon Data="{x:Static app:Icons.Pause}" Width="24" Height="24"
                                              IsVisible="{Binding IsPlaying}" />
                                </Grid>
                            </Button>
                            <Button Classes="transport" Command="{Binding NextCommand}" ToolTip.Tip="Next">
                                <PathIcon Data="{x:Static app:Icons.SkipNext}" Width="20" Height="20" />
                            </Button>
                            <Button Classes="transport" Classes.active="{Binding IsLoopActive}"
                                    Command="{Binding ToggleLoopCommand}" ToolTip.Tip="{Binding LoopToolTip}">
                                <PathIcon Data="{Binding LoopIcon}" Width="18" Height="18" />
                            </Button>
                        </StackPanel>

                        <Grid Grid.Column="3" ColumnDefinitions="Auto,Auto,Auto,Auto,*" VerticalAlignment="Center">
                            <Button Grid.Column="0" Classes="transport"
                                    Width="28" Height="28" Padding="5" Margin="0,0,2,0"
                                    Command="{Binding OpenAddToPlaylistForCurrentSongCommand}"
                                    IsEnabled="{Binding HasCurrentSong}"
                                    ToolTip.Tip="Add to playlist (Ctrl+P)">
                                <PathIcon Data="{x:Static app:Icons.PlaylistAdd}" Width="15" Height="15" Opacity="0.7" />
                            </Button>
                            <Button Grid.Column="1" Classes="transport" Classes.active="{Binding IsLyricsOpen}"
                                    Width="28" Height="28" Padding="5" Margin="0,0,2,0"
                                    Command="{Binding ToggleLyricsOpenCommand}" ToolTip.Tip="Lyrics">
                                <PathIcon Data="{x:Static app:Icons.Lyrics}" Width="15" Height="15" Opacity="0.7" />
                            </Button>
                            <Button Grid.Column="2" Classes="transport" Width="28" Height="28" Padding="5"
                                    Margin="0,0,2,0" Command="{Binding RefreshOutputDevicesCommand}"
                                    ToolTip.Tip="Playback device">
                                <Button.Flyout>
                                    <Flyout Placement="Top" FlyoutPresenterClasses="stramp-device-flyout">
                                        <ListBox Classes="device-picker" FontSize="12"
                                                 MinWidth="200" MaxWidth="320" MaxHeight="220"
                                                 ItemsSource="{Binding OutputDevices}"
                                                 SelectedItem="{Binding SelectedOutputDevice}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OutputDeviceRow">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                                        <PathIcon Grid.Column="0" Data="{x:Static app:Icons.OutputDevice}"
                                                                  Width="14" Height="14" Opacity="0.6"
                                                                  VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Flyout>
                                </Button.Flyout>
                                <PathIcon Data="{x:Static app:Icons.OutputDevice}" Width="15" Height="15" Opacity="0.7" />
                            </Button>
                            <Button Grid.Column="3" Classes="transport" Classes.active="{Binding IsMuted}"
                                    Width="28" Height="28" Padding="5" Margin="0,0,6,0"
                                    Command="{Binding ToggleMuteCommand}" ToolTip.Tip="{Binding VolumeToolTip}">
                                <PathIcon Data="{Binding VolumeIcon}" Width="16" Height="16" Opacity="0.7" />
                            </Button>
                            <Slider x:Name="VolumeSlider" Grid.Column="4" Minimum="0" Maximum="100" Value="{Binding Volume}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <!-- Compact Control Bar (Volume underneath media buttons) when room is constrained -->
                    <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0" HorizontalAlignment="Center"
                                IsVisible="{Binding IsCompactControlBar}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <Button Classes="transport" Classes.active="{Binding Shuffled}" Command="{Binding ToggleShuffleCommand}"
                                    ToolTip.Tip="Shuffle">
                                <PathIcon Data="{x:Static app:Icons.Shuffle}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="transport" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous">
                                <PathIcon Data="{x:Static app:Icons.SkipPrevious}" Width="20" Height="20" />
                            </Button>
                            <Button Classes="play-pause" Command="{Binding PlayPauseCommand}">
                                <Grid Width="24" Height="24">
                                    <PathIcon Data="{x:Static app:Icons.Play}" Width="24" Height="24"
                                              IsVisible="{Binding !IsPlaying}">
                                        <PathIcon.RenderTransform>
                                            <TranslateTransform X="1.5" />
                                        </PathIcon.RenderTransform>
                                    </PathIcon>
                                    <PathIcon Data="{x:Static app:Icons.Pause}" Width="24" Height="24"
                                              IsVisible="{Binding IsPlaying}" />
                                </Grid>
                            </Button>
                            <Button Classes="transport" Command="{Binding NextCommand}" ToolTip.Tip="Next">
                                <PathIcon Data="{x:Static app:Icons.SkipNext}" Width="20" Height="20" />
                            </Button>
                            <Button Classes="transport" Classes.active="{Binding IsLoopActive}"
                                    Command="{Binding ToggleLoopCommand}" ToolTip.Tip="{Binding LoopToolTip}">
                                <PathIcon Data="{Binding LoopIcon}" Width="18" Height="18" />
                            </Button>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" Width="284" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Grid.Column="0" Classes="transport"
                                    Width="28" Height="28" Padding="5" Margin="0,0,2,0"
                                    Command="{Binding OpenAddToPlaylistForCurrentSongCommand}"
                                    IsEnabled="{Binding HasCurrentSong}"
                                    ToolTip.Tip="Add to playlist (Ctrl+P)">
                                <PathIcon Data="{x:Static app:Icons.PlaylistAdd}" Width="15" Height="15" Opacity="0.7" />
                            </Button>
                            <Button Grid.Column="1" Classes="transport" Classes.active="{Binding IsLyricsOpen}"
                                    Width="28" Height="28" Padding="5" Margin="0,0,2,0"
                                    Command="{Binding ToggleLyricsOpenCommand}" ToolTip.Tip="Lyrics">
                                <PathIcon Data="{x:Static app:Icons.Lyrics}" Width="15" Height="15" Opacity="0.7" />
                            </Button>
                            <Button Grid.Column="2" Classes="transport" Width="28" Height="28" Padding="5"
                                    Margin="0,0,2,0" Command="{Binding RefreshOutputDevicesCommand}"
                                    ToolTip.Tip="Playback device">
                                <Button.Flyout>
                                    <Flyout Placement="Top" FlyoutPresenterClasses="stramp-device-flyout">
                                        <ListBox Classes="device-picker" FontSize="12"
                                                 MinWidth="200" MaxWidth="320" MaxHeight="220"
                                                 ItemsSource="{Binding OutputDevices}"
                                                 SelectedItem="{Binding SelectedOutputDevice}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OutputDeviceRow">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                                        <PathIcon Grid.Column="0" Data="{x:Static app:Icons.OutputDevice}"
                                                                  Width="14" Height="14" Opacity="0.6"
                                                                  VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Flyout>
                                </Button.Flyout>
                                <PathIcon Data="{x:Static app:Icons.OutputDevice}" Width="15" Height="15" Opacity="0.7" />
                            </Button>
                            <Button Grid.Column="3" Classes="transport" Classes.active="{Binding IsMuted}"
                                    Width="28" Height="28" Padding="5" Margin="0,0,6,0"
                                    Command="{Binding ToggleMuteCommand}" ToolTip.Tip="{Binding VolumeToolTip}">
                                <PathIcon Data="{Binding VolumeIcon}" Width="16" Height="16" Opacity="0.7" />
                            </Button>
                            <Slider x:Name="CompactVolumeSlider" Grid.Column="4" Minimum="0" Maximum="100" Value="{Binding Volume}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Right Splitter -->
                <GridSplitter x:Name="RightSplitter" Grid.Column="3"
                              Width="8" Margin="1,0" Background="Transparent"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              IsVisible="{Binding IsUpNextOpen}">
                    <GridSplitter.Template>
                        <ControlTemplate>
                            <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Border Width="2" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                        Background="{DynamicResource AppIconBrush}" Opacity="0.15" />
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- Queue sidebar (collapsible) -->
                <Border x:Name="QueueBorder" Grid.Column="4" ClipToBounds="True" HorizontalAlignment="Stretch">
                    <DockPanel HorizontalAlignment="Stretch" Margin="10,0,0,0">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Grid.Column="0" Text="UP NEXT" Classes="section-header" VerticalAlignment="Center" Margin="0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Classes="transport" Width="24" Height="24" Padding="3"
                                        Command="{Binding ReshuffleCommand}" ToolTip.Tip="Reshuffle remaining">
                                    <PathIcon Data="{x:Static app:Icons.Refresh}" Width="14" Height="14" />
                                </Button>
                                <Button Classes="transport" Width="24" Height="24" Padding="3"
                                        Command="{Binding ToggleUpNextOpenCommand}" ToolTip.Tip="Collapse Up Next">
                                    <PathIcon Data="{x:Static app:Icons.PanelRight}" Width="14" Height="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="QueueList" Classes="flat-list" ItemsSource="{Binding QueueRows}"
                                 ContainerPrepared="OnSongContainerPrepared"
                                 ContainerClearing="OnSongContainerClearing"
                                 Tapped="OnQueueTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SongRow">
                                    <Border Classes="queue-row" Classes.playing="{Binding IsCurrent}" ToolTip.Tip="Right-click to remove from queue">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Add to playlist…"
                                                          Command="{Binding #Root.DataContext.OpenAddToPlaylistForSongCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{x:Static app:Icons.PlaylistAdd}" Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Remove from queue"
                                                          Command="{Binding #Root.DataContext.RemoveFromQueueCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{x:Static app:Icons.Delete}" Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="Remove song (permanent)…"
                                                          Command="{Binding #Root.DataContext.RequestDeleteSongPermanentlyCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{x:Static app:Icons.Delete}" Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <!-- Grid rather than a StackPanel: a horizontal StackPanel hands children
                                             infinite width, so ellipsising kicks in far too early. -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Grid.Column="0" Classes="art-frame" Width="40" Height="40">
                                                <Grid>
                                                    <PathIcon Data="{x:Static app:Icons.MusicNote}" Width="18" Height="18" Opacity="0.35"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsVisible="{Binding ArtBitmap, Converter={StaticResource NullToBool}, ConverterParameter=invert}" />
                                                    <Image Source="{Binding ArtBitmap}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                                           IsVisible="{Binding ArtBitmap, Converter={StaticResource NullToBool}}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Classes="queue-title" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- Resize grips (we draw our own chrome, so the system border is gone) -->
        <Grid x:Name="ResizeGrips" RowDefinitions="5,*,5" ColumnDefinitions="5,*,5">
            <Border Grid.Row="0" Grid.Column="0" Background="Transparent" Cursor="TopLeftCorner"
                    Tag="NorthWest" PointerPressed="OnResizePressed" />
            <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Cursor="TopSide"
                    Tag="North" PointerPressed="OnResizePressed" />
            <Border Grid.Row="0" Grid.Column="2" Background="Transparent" Cursor="TopRightCorner"
                    Tag="NorthEast" PointerPressed="OnResizePressed" />
            <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Cursor="LeftSide"
                    Tag="West" PointerPressed="OnResizePressed" />
            <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Cursor="RightSide"
                    Tag="East" PointerPressed="OnResizePressed" />
            <Border Grid.Row="2" Grid.Column="0" Background="Transparent" Cursor="BottomLeftCorner"
                    Tag="SouthWest" PointerPressed="OnResizePressed" />
            <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Cursor="BottomSide"
                    Tag="South" PointerPressed="OnResizePressed" />
            <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Cursor="BottomRightCorner"
                    Tag="SouthEast" PointerPressed="OnResizePressed" />
        </Grid>

        <!-- In-app settings dialog -->
        <Border x:Name="SettingsScrim" Classes="dialog-scrim" IsVisible="{Binding IsSettingsOpen}"
                PointerPressed="OnScrimPressed">
            <Border Classes="dialog-card" Width="560" MaxWidth="560" MaxHeight="660" Margin="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel Margin="22">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Settings" Classes="dialog-title" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="transport" Width="30" Height="30" Padding="6"
                                Command="{Binding CloseSettingsCommand}">
                            <PathIcon Data="{x:Static app:Icons.WindowClose}" Width="11" Height="11" />
                        </Button>
                    </Grid>

                    <Button DockPanel.Dock="Bottom" Content="Reset to defaults"
                            Command="{Binding Theme.ResetToDefaultsCommand}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" />

                    <ScrollViewer x:Name="SettingsScroller">
                        <StackPanel Spacing="18">
                            <TextBlock Text="LIBRARY SOURCES" Classes="section-header" Margin="0,8,0,0" />

                            <StackPanel Spacing="8">
                                <Border Classes="library-locations">
                                    <ItemsControl ItemsSource="{Binding LibraryLocations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LibraryLocationRow">
                                                <Border Classes="library-location-row">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                                        <Border Grid.Column="0" Classes="library-location-icon">
                                                            <PathIcon Data="{x:Static app:Icons.FolderOpen}"
                                                                      Width="16" Height="16" Opacity="0.8" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Path}" Classes="field-hint"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding Path}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Classes="transport" Width="28" Height="28"
                                                                Padding="6" VerticalAlignment="Center"
                                                                Command="{Binding #Root.DataContext.RemoveLibraryLocationCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Remove library folder">
                                                            <PathIcon Data="{x:Static app:Icons.Delete}" Width="14" Height="14" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Button Classes="add-library-location" HorizontalAlignment="Left"
                                        Click="OnOpenLibraryClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{x:Static app:Icons.Add}" Width="15" Height="15" />
                                        <TextBlock Text="Add folder" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            IsVisible="{Binding IsLibraryScanning}">
                                    <ProgressBar Width="82" Height="3" IsIndeterminate="True"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Text="Scanning library in the background…"
                                               Classes="field-hint" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Music and playlists from every folder are combined into one library. Nested or duplicate files are only added once." />
                                <StackPanel Spacing="4" Margin="0,4,0,0">
                                    <ToggleSwitch IsChecked="{Binding Theme.CacheLibraryMetadata}"
                                                  OnContent="Cache metadata for optimized reads on slower drives"
                                                  OffContent="Cache metadata for optimized reads on slower drives" />
                                    <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                               Text="Stores titles, artists, albums, and durations in Local AppData. Unchanged tracks no longer need to be opened again during a library scan." />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="PLAYLIST STORAGE" Classes="section-header" Margin="0,8,0,0" />

                            <StackPanel Spacing="8">
                                <Border Classes="library-locations">
                                    <Border Classes="library-location-row">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" Classes="library-location-icon">
                                                <PathIcon Data="{x:Static app:Icons.PlaylistAdd}"
                                                          Width="16" Height="16" Opacity="0.8" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="Playlists Folder (.m3u8)" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding EffectivePlaylistsDirectory}" Classes="field-hint"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding EffectivePlaylistsDirectory}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="transport" Padding="8,4" Height="28"
                                                    Click="OnChangePlaylistsFolderClicked"
                                                    ToolTip.Tip="Choose a custom folder to store all your .m3u8 playlists">
                                                <TextBlock Text="Change…" FontSize="11" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="transport" Padding="8,4" Height="28"
                                                    Click="OnOpenPlaylistsFolderInExplorerClicked"
                                                    ToolTip.Tip="Open this folder in Windows File Explorer">
                                                <TextBlock Text="Reveal" FontSize="11" />
                                            </Button>
                                            <Button Grid.Column="4" Classes="transport" Width="28" Height="28" Padding="6"
                                                    Command="{Binding ResetPlaylistsDirectoryCommand}"
                                                    IsVisible="{Binding HasCustomPlaylistsDirectory}"
                                                    ToolTip.Tip="Reset to default playlists folder">
                                                <PathIcon Data="{x:Static app:Icons.Delete}" Width="13" Height="13" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Border>
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Created playlists are automatically written as standard .m3u8 files in this folder so you always have them on disk." />
                            </StackPanel>

                            <TextBlock Text="VISUALS" Classes="section-header" Margin="0,8,0,0" />

                            <StackPanel Spacing="10">
                                <ToggleSwitch IsChecked="{Binding Theme.ShowRingVisualizer}"
                                              OnContent="Central visualizer" OffContent="Central visualizer" />
                                <ToggleSwitch IsChecked="{Binding Theme.ShowBottomVisualizer}"
                                              OnContent="Bottom visualizer" OffContent="Bottom visualizer" />
                                <StackPanel Spacing="4" IsEnabled="{Binding Theme.ShowBottomVisualizer}"
                                            Opacity="{Binding Theme.ShowBottomVisualizer, Converter={StaticResource EnabledOpacity}}">
                                    <TextBlock Text="Bottom visualizer opacity" Classes="field-label" />
                                    <Slider Minimum="0" Maximum="1" Value="{Binding Theme.BottomVisualizerOpacity}" />
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding Theme.AnimateAlbumArt}"
                                              OnContent="Album art animation" OffContent="Album art animation" />
                                <ToggleSwitch IsChecked="{Binding Theme.DisableAnimations}"
                                              OnContent="Disable animations" OffContent="Disable animations" />
                                <ToggleSwitch IsChecked="{Binding Theme.CircularAlbumArt}"
                                              OnContent="Circular album cover" OffContent="Circular album cover" />
                                <ToggleSwitch IsChecked="{Binding Theme.ShowWaveformProgress}"
                                              OnContent="Waveform progress bar" OffContent="Waveform progress bar" />
                            </StackPanel>

                            <TextBlock Text="AUDIO" Classes="section-header" Margin="0,6,0,0" />

                            <StackPanel Spacing="5">
                                <ToggleSwitch IsChecked="{Binding Theme.NormalizeAudio}"
                                              OnContent="Normalize track loudness"
                                              OffContent="Normalize track loudness" />
                                <ComboBox ItemsSource="{Binding Theme.NormalizationLevels}"
                                          SelectedItem="{Binding Theme.NormalizationLevel}"
                                          IsEnabled="{Binding Theme.NormalizeAudio}"
                                          HorizontalAlignment="Left" MinWidth="140" />
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Analyzes and caches the library in the background, then applies a constant clipping-safe gain. No compression, limiting, or file changes." />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <ToggleSwitch IsChecked="{Binding Theme.MonoAudio}"
                                              OnContent="Mono audio" OffContent="Mono audio" />
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Sums the channels and sends the same signal to both ears. Useful for single-sided listening or hearing loss in one ear." />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <ToggleSwitch IsChecked="{Binding Theme.SurroundSound}"
                                              OnContent="5.1 surround sound" OffContent="5.1 surround sound" />
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Plays multi-channel tracks in 5.1 surround when supported by the audio device. When off or on stereo outputs, folds surround down to two ears properly and losslessly." />
                            </StackPanel>

                            <TextBlock Text="EQUALIZER" Classes="section-header" Margin="0,6,0,0" />

                            <StackPanel Spacing="10">
                                <ToggleSwitch IsChecked="{Binding Theme.EqualizerEnabled}"
                                              OnContent="Equalizer enabled" OffContent="Equalizer enabled" />

                                <Border Classes="eq-panel" IsEnabled="{Binding Theme.EqualizerEnabled}"
                                        Opacity="{Binding Theme.EqualizerEnabled, Converter={StaticResource EnabledOpacity}}">
                                    <StackPanel Spacing="6">
                                        <ComboBox ItemsSource="{Binding Theme.EqualizerPresets}"
                                                  SelectedItem="{Binding Theme.SelectedEqualizerPreset}"
                                                  PlaceholderText="Choose a preset…"
                                                  HorizontalAlignment="Stretch" FontSize="12"
                                                  ToolTip.Tip="Loads a curve into the bands below">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="playback:EqualizerPreset">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <ItemsControl ItemsSource="{Binding Theme.EqualizerBands}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EqualizerBandViewModel">
                                                    <StackPanel Spacing="4" Width="44">
                                                        <TextBlock Text="{Binding GainLabel}" FontSize="10"
                                                                   Opacity="0.85" HorizontalAlignment="Center" />
                                                        <Slider Orientation="Vertical" Height="110"
                                                                Minimum="-20" Maximum="20"
                                                                Value="{Binding Gain}"
                                                                HorizontalAlignment="Center" />
                                                        <TextBox Text="{Binding Frequency, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 Classes="band-frequency" ToolTip.Tip="Centre frequency in Hz" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Button Content="Flatten" Command="{Binding Theme.ResetEqualizerCommand}"
                                                    FontSize="12" Padding="10,4" ToolTip.Tip="Set every gain back to 0 dB" />
                                            <Button Content="Reset bands" Command="{Binding Theme.ResetEqualizerBandsCommand}"
                                                    FontSize="12" Padding="10,4" ToolTip.Tip="Put the centre frequencies back to their defaults" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="ENHANCEMENTS" Classes="section-header" Margin="0,6,0,0" />

                            <StackPanel Spacing="10">
                                <ToggleSwitch IsChecked="{Binding Theme.EffectsEnabled}"
                                              OnContent="Enhancements enabled" OffContent="Enhancements enabled" />

                                <Border Classes="eq-panel" IsEnabled="{Binding Theme.EffectsEnabled}"
                                        Opacity="{Binding Theme.EffectsEnabled, Converter={StaticResource EnabledOpacity}}">
                                    <StackPanel Spacing="6">
                                    <ItemsControl ItemsSource="{Binding Theme.AudioEffects}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AudioEffectViewModel">
                                                <Grid ColumnDefinitions="96,*,34" Margin="0,0,0,2"
                                                      ToolTip.Tip="{Binding Description}">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                                               VerticalAlignment="Center" Opacity="0.8" />
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="10"
                                                            TickFrequency="0.5" IsSnapToTickEnabled="False"
                                                            Value="{Binding Amount}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding AmountLabel}" FontSize="10"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               Opacity="0.6" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                        <Button Content="No effects" Command="{Binding Theme.ResetEffectsCommand}"
                                                HorizontalAlignment="Center" FontSize="12" Padding="10,4"
                                                ToolTip.Tip="Turn all five enhancement amounts down to zero" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="LYRICS" Classes="section-header" Margin="0,6,0,0" />

                            <StackPanel Spacing="5">
                                <ToggleSwitch IsChecked="{Binding Theme.LrcLibLookup}"
                                              OnContent="Look up lyrics on LRCLIB"
                                              OffContent="Look up lyrics on LRCLIB" />
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="An .lrc file sitting next to the track is always used first. When there isn't one, the playing track's title, artist, album and length are sent to lrclib.net to search for synced lyrics. Results are cached, so each track is only ever looked up once." />
                            </StackPanel>

                            <TextBlock Text="DISCORD" Classes="section-header" Margin="0,6,0,0" />

                            <StackPanel Spacing="5">
                                <ToggleSwitch IsChecked="{Binding Theme.DiscordRichPresenceEnabled}"
                                              OnContent="Show now playing on Discord"
                                              OffContent="Show now playing on Discord" />
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Requires the Discord desktop app to be running. Shows the track title, artist, and a live progress bar to your friends." />
                                <TextBox Text="{Binding Theme.DiscordClientId}"
                                         PlaceholderText="Custom Discord Application ID (optional)"
                                         IsEnabled="{Binding Theme.DiscordRichPresenceEnabled}" />
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Advanced: leave blank to use str-amp's built-in Discord app. Only set this to point at your own Discord Application (discord.com/developers/applications) instead." />
                            </StackPanel>

                            <TextBlock Text="WINDOWS" Classes="section-header" Margin="0,6,0,0" />

                            <StackPanel Spacing="10">
                                <ToggleSwitch IsChecked="{Binding Theme.EnsureDesktopShortcut}"
                                              OnContent="Ensure Desktop Shortcut"
                                              OffContent="Ensure Desktop Shortcut" />
                                <ToggleSwitch IsChecked="{Binding Theme.EnsureStartMenuShortcut}"
                                              OnContent="Ensure appearance in Windows Start Menu"
                                              OffContent="Ensure appearance in Windows Start Menu" />
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Shortcuts point to this copy of Stramp and use its app icon. Turning an option off removes the shortcut created by Stramp." />
                            </StackPanel>

                            <TextBlock Text="THEME" Classes="section-header" Margin="0,6,0,0" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Style" Classes="field-label" />
                                <ComboBox ItemsSource="{Binding Theme.Style.Options}"
                                          SelectedItem="{Binding Theme.Style.Selected}"
                                          HorizontalAlignment="Left" MinWidth="140">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="theming:VisualTheme">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="field-hint"
                                           Text="Dark and Light follow your colors below. Aero adds translucent glass panels, Windows 7 style window buttons, a glossy green progress bar and a glass play button." />
                                <TextBlock Text="Album art color matching" Classes="field-label" Margin="0,4,0,0" />
                                <ComboBox ItemsSource="{Binding Theme.ArtColorModes}"
                                          SelectedItem="{Binding Theme.ArtColorMode}"
                                          HorizontalAlignment="Left" MinWidth="140" />
                                <TextBlock Classes="field-hint"
                                           Text="Inferred creates a polished palette; Direct searches inward from the cover's top and bottom for real colors; None uses your manual theme." />
                            </StackPanel>

                            <StackPanel Spacing="8" IsEnabled="{Binding Theme.UsesManualColors}"
                                        Opacity="{Binding Theme.UsesManualColors, Converter={StaticResource EnabledOpacity}}">
                                <TextBlock Text="Presets" Classes="field-label" />
                                <ItemsControl ItemsSource="{Binding Theme.Presets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ThemePreset">
                                            <Button Classes="preset" Margin="0,0,8,8"
                                                    Command="{Binding #Root.DataContext.Theme.ApplyPresetCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Border Width="13" Height="13" CornerRadius="7"
                                                            Background="{Binding PrimaryBrush}" VerticalAlignment="Center" />
                                                    <Border Width="13" Height="13" CornerRadius="7"
                                                            Background="{Binding SecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Primary accent" Classes="field-label" />
                                    <ContentControl Content="{Binding Theme.Primary}"
                                                    ContentTemplate="{StaticResource ColorEditorTemplate}" />
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Secondary accent" Classes="field-label" />
                                    <ContentControl Content="{Binding Theme.Secondary}"
                                                    ContentTemplate="{StaticResource ColorEditorTemplate}" />
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Background" Classes="field-label" />
                                    <ContentControl Content="{Binding Theme.Background}"
                                                    ContentTemplate="{StaticResource ColorEditorTemplate}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="LISTENING TIME" Classes="section-header" Margin="0,6,0,0" />

                            <StackPanel Spacing="5">
                                <ToggleSwitch IsChecked="{Binding Theme.ListeningStatsEnabled}"
                                              OnContent="Track listening stats"
                                              OffContent="Track listening stats" />
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Powers the View Stats panel and the totals below. Stored locally only; turning this off stops new listening from being recorded, but keeps whatever's already saved." />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Classes="library-locations" Padding="14,12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Total Time Listened" Classes="field-label" FontSize="11" Opacity="0.6" />
                                        <TextBlock Text="{Binding TotalTimeListenedText}" FontSize="18" FontWeight="SemiBold"
                                                   ToolTip.Tip="{Binding TotalTimeListenedTooltip}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="library-locations" Padding="14,12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Time Listened This Month" Classes="field-label" FontSize="11" Opacity="0.6" />
                                        <TextBlock Text="{Binding MonthlyTimeListenedText}" FontSize="18" FontWeight="SemiBold"
                                                   ToolTip.Tip="{Binding MonthlyTimeListenedTooltip}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Classes="library-locations" Padding="12,10" Margin="0,-6,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Listening History Database (.json)" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ListeningHistoryFilePath}" Classes="field-hint"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding ListeningHistoryFilePath}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="transport" Padding="8,4" Height="28"
                                            Click="OnOpenListeningHistoryClicked"
                                            ToolTip.Tip="Open listening history JSON in Windows File Explorer">
                                        <TextBlock Text="Reveal" FontSize="11" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- First-run setup wizard: no close button and the scrim doesn't dismiss it, so it has
             to be stepped through (Back is still allowed) rather than skipped. -->
        <Border x:Name="SetupWizardScrim" Classes="dialog-scrim" IsVisible="{Binding IsSetupWizardOpen}">
            <Border Classes="dialog-card" Width="560" MaxWidth="560" MaxHeight="640" Margin="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel Margin="22">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="{Binding SetupWizard.StepTitle}" Classes="dialog-title" />
                        <TextBlock Grid.Column="1" Text="{Binding SetupWizard.StepNumberLabel}"
                                   Classes="field-hint" VerticalAlignment="Center" />
                    </Grid>

                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,14,0,0">
                        <Button Grid.Column="1" Classes="playlist-action-btn" Content="Back"
                                Command="{Binding SetupWizard.BackCommand}"
                                IsVisible="{Binding !SetupWizard.IsFirstStep}" />
                        <Button Grid.Column="2" Classes="playlist-action-btn primary"
                                Content="{Binding SetupWizard.NextButtonText}"
                                Command="{Binding SetupWizard.NextCommand}" />
                    </Grid>

                    <ScrollViewer x:Name="SetupWizardScroller">
                        <StackPanel Spacing="18" Margin="0,10,0,0">

                            <StackPanel Spacing="12"
                                        IsVisible="{Binding SetupWizard.CurrentStep, Converter={StaticResource EnumEquals}, ConverterParameter=Welcome}">
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Text="str-amp has installed itself so it's ready whenever you open it again:" />
                                <Border Classes="library-locations" Padding="12,10">
                                    <TextBlock Text="{Binding SetupWizard.InstallDirectory}" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="The next few steps walk through the basics. Every one of these can be changed later through stramp → Settings…" />
                            </StackPanel>

                            <StackPanel Spacing="12"
                                        IsVisible="{Binding SetupWizard.CurrentStep, Converter={StaticResource EnumEquals}, ConverterParameter=Library}">
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Which folders should str-amp build your library from?" />
                                <Border Classes="library-locations">
                                    <ItemsControl ItemsSource="{Binding LibraryLocations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LibraryLocationRow">
                                                <Border Classes="library-location-row">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                                        <Border Grid.Column="0" Classes="library-location-icon">
                                                            <PathIcon Data="{x:Static app:Icons.FolderOpen}"
                                                                      Width="16" Height="16" Opacity="0.8" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Path}" Classes="field-hint"
                                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Classes="transport" Width="28" Height="28"
                                                                Padding="6" VerticalAlignment="Center"
                                                                Command="{Binding #Root.DataContext.RemoveLibraryLocationCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Remove library folder">
                                                            <PathIcon Data="{x:Static app:Icons.Delete}" Width="14" Height="14" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Button Classes="add-library-location" HorizontalAlignment="Left"
                                        Click="OnOpenLibraryClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{x:Static app:Icons.Add}" Width="15" Height="15" />
                                        <TextBlock Text="Add folder" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Spacing="4" Margin="0,4,0,0">
                                    <ToggleSwitch IsChecked="{Binding Theme.CacheLibraryMetadata}"
                                                  OnContent="Cache metadata for optimized reads on slower drives"
                                                  OffContent="Cache metadata for optimized reads on slower drives" />
                                    <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                               Text="Recommended once your library passes a couple hundred songs. Stores titles, artists, albums, and durations in Local AppData." />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="12"
                                        IsVisible="{Binding SetupWizard.CurrentStep, Converter={StaticResource EnumEquals}, ConverterParameter=Playlists}">
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Playlists you create are written as standard .m3u8 files here:" />
                                <Border Classes="library-locations">
                                    <Border Classes="library-location-row">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" Classes="library-location-icon">
                                                <PathIcon Data="{x:Static app:Icons.PlaylistAdd}" Width="16" Height="16" Opacity="0.8" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding EffectivePlaylistsDirectory}"
                                                       Classes="field-hint" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EffectivePlaylistsDirectory}" />
                                            <Button Grid.Column="2" Classes="transport" Padding="8,4" Height="28"
                                                    Click="OnChangePlaylistsFolderClicked">
                                                <TextBlock Text="Change…" FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Border>
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="This default is fine for most people; change it any time from Settings." />
                            </StackPanel>

                            <StackPanel Spacing="14"
                                        IsVisible="{Binding SetupWizard.CurrentStep, Converter={StaticResource EnumEquals}, ConverterParameter=Audio}">
                                <StackPanel Spacing="5">
                                    <ToggleSwitch IsChecked="{Binding Theme.NormalizeAudio}"
                                                  OnContent="Normalize track loudness" OffContent="Normalize track loudness" />
                                    <ComboBox ItemsSource="{Binding Theme.NormalizationLevels}"
                                              SelectedItem="{Binding Theme.NormalizationLevel}"
                                              IsEnabled="{Binding Theme.NormalizeAudio}"
                                              HorizontalAlignment="Left" MinWidth="140" />
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding Theme.MonoAudio}"
                                              OnContent="Mono audio" OffContent="Mono audio" />
                                <ToggleSwitch IsChecked="{Binding Theme.SurroundSound}"
                                              OnContent="5.1 surround sound" OffContent="5.1 surround sound" />

                                <ToggleSwitch IsChecked="{Binding Theme.EqualizerEnabled}"
                                              OnContent="Equalizer enabled" OffContent="Equalizer enabled" />
                                <Border Classes="eq-panel" IsEnabled="{Binding Theme.EqualizerEnabled}"
                                        Opacity="{Binding Theme.EqualizerEnabled, Converter={StaticResource EnabledOpacity}}">
                                    <StackPanel Spacing="6">
                                        <ComboBox ItemsSource="{Binding Theme.EqualizerPresets}"
                                                  SelectedItem="{Binding Theme.SelectedEqualizerPreset}"
                                                  PlaceholderText="Choose a preset…"
                                                  HorizontalAlignment="Stretch" FontSize="12">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="playback:EqualizerPreset">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ItemsControl ItemsSource="{Binding Theme.EqualizerBands}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EqualizerBandViewModel">
                                                    <StackPanel Spacing="4" Width="40">
                                                        <TextBlock Text="{Binding GainLabel}" FontSize="10"
                                                                   Opacity="0.85" HorizontalAlignment="Center" />
                                                        <Slider Orientation="Vertical" Height="100"
                                                                Minimum="-20" Maximum="20"
                                                                Value="{Binding Gain}" HorizontalAlignment="Center" />
                                                        <TextBox Text="{Binding Frequency, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 Classes="band-frequency" ToolTip.Tip="Centre frequency in Hz" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="Flatten" Command="{Binding Theme.ResetEqualizerCommand}"
                                                HorizontalAlignment="Center" FontSize="12" Padding="10,4" />
                                    </StackPanel>
                                </Border>

                                <ToggleSwitch IsChecked="{Binding Theme.EffectsEnabled}"
                                              OnContent="Enhancements enabled" OffContent="Enhancements enabled" />
                                <Border Classes="eq-panel" IsEnabled="{Binding Theme.EffectsEnabled}"
                                        Opacity="{Binding Theme.EffectsEnabled, Converter={StaticResource EnabledOpacity}}">
                                    <StackPanel Spacing="6">
                                        <ItemsControl ItemsSource="{Binding Theme.AudioEffects}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AudioEffectViewModel">
                                                    <Grid ColumnDefinitions="96,*,34" Margin="0,0,0,2"
                                                          ToolTip.Tip="{Binding Description}">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                                                   VerticalAlignment="Center" Opacity="0.8" />
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="10"
                                                                TickFrequency="0.5" IsSnapToTickEnabled="False"
                                                                Value="{Binding Amount}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding AmountLabel}" FontSize="10"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                   Opacity="0.6" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="No effects" Command="{Binding Theme.ResetEffectsCommand}"
                                                HorizontalAlignment="Center" FontSize="12" Padding="10,4" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="14"
                                        IsVisible="{Binding SetupWizard.CurrentStep, Converter={StaticResource EnumEquals}, ConverterParameter=VisualsArt}">
                                <Border Classes="art-frame" Classes.circular="{Binding Theme.CircularAlbumArt}"
                                        Width="140" Height="140" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <Grid>
                                        <PathIcon Data="{x:Static app:Icons.MusicNote}" Width="40" Height="40" Opacity="0.35"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsVisible="{Binding CurrentArtBitmap, Converter={StaticResource NullToBool}, ConverterParameter=invert}" />
                                        <Image Source="{Binding CurrentArtBitmap}" Stretch="UniformToFill"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"
                                               IsVisible="{Binding CurrentArtBitmap, Converter={StaticResource NullToBool}}" />
                                    </Grid>
                                </Border>
                                <ToggleSwitch IsChecked="{Binding Theme.CircularAlbumArt}"
                                              OnContent="Circular album cover" OffContent="Circular album cover" />
                                <ToggleSwitch IsChecked="{Binding Theme.AnimateAlbumArt}"
                                              OnContent="Album art animation" OffContent="Album art animation" />
                                <ToggleSwitch IsChecked="{Binding Theme.ShowWaveformProgress}"
                                              OnContent="Waveform progress bar" OffContent="Waveform progress bar" />
                            </StackPanel>

                            <StackPanel Spacing="14"
                                        IsVisible="{Binding SetupWizard.CurrentStep, Converter={StaticResource EnumEquals}, ConverterParameter=VisualsTheme}">
                                <ToggleSwitch IsChecked="{Binding Theme.ShowRingVisualizer}"
                                              OnContent="Central visualizer" OffContent="Central visualizer" />
                                <ToggleSwitch IsChecked="{Binding Theme.ShowBottomVisualizer}"
                                              OnContent="Bottom visualizer" OffContent="Bottom visualizer" />
                                <StackPanel Spacing="4" IsEnabled="{Binding Theme.ShowBottomVisualizer}"
                                            Opacity="{Binding Theme.ShowBottomVisualizer, Converter={StaticResource EnabledOpacity}}">
                                    <TextBlock Text="Bottom visualizer opacity" Classes="field-label" />
                                    <Slider Minimum="0" Maximum="1" Value="{Binding Theme.BottomVisualizerOpacity}" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Album art color matching" Classes="field-label" />
                                    <ComboBox ItemsSource="{Binding Theme.ArtColorModes}"
                                              SelectedItem="{Binding Theme.ArtColorMode}"
                                              HorizontalAlignment="Left" MinWidth="140" />
                                    <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                               Text="Inferred creates a polished palette from the cover; Direct samples its real colors; None uses a manual theme you can set up later in Settings." />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="14"
                                        IsVisible="{Binding SetupWizard.CurrentStep, Converter={StaticResource EnumEquals}, ConverterParameter=LyricsAndDiscord}">
                                <StackPanel Spacing="5">
                                    <ToggleSwitch IsChecked="{Binding Theme.LrcLibLookup}"
                                                  OnContent="Look up lyrics on LRCLIB" OffContent="Look up lyrics on LRCLIB" />
                                    <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                               Text="Sends the playing track's title, artist, album and length to lrclib.net when there's no .lrc file on disk already." />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <ToggleSwitch IsChecked="{Binding Theme.DiscordRichPresenceEnabled}"
                                                  OnContent="Show now playing on Discord" OffContent="Show now playing on Discord" />
                                    <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                               Text="Requires the Discord desktop app to be running." />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="14"
                                        IsVisible="{Binding SetupWizard.CurrentStep, Converter={StaticResource EnumEquals}, ConverterParameter=Shortcuts}">
                                <ToggleSwitch IsChecked="{Binding Theme.EnsureDesktopShortcut}"
                                              OnContent="Desktop shortcut" OffContent="Desktop shortcut" />
                                <ToggleSwitch IsChecked="{Binding Theme.EnsureStartMenuShortcut}"
                                              OnContent="Start Menu shortcut" OffContent="Start Menu shortcut" />
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Shortcuts point to this copy of str-amp and use its app icon." />
                            </StackPanel>

                            <StackPanel Spacing="8"
                                        IsVisible="{Binding SetupWizard.CurrentStep, Converter={StaticResource EnumEquals}, ConverterParameter=ListeningStats}">
                                <ToggleSwitch IsChecked="{Binding Theme.ListeningStatsEnabled}"
                                              OnContent="Track listening stats" OffContent="Track listening stats" />
                                <TextBlock Classes="field-hint" TextWrapping="Wrap"
                                           Text="Powers the View Stats panel: most-played songs and artists, total and monthly listening time. Stored locally only; nothing is sent anywhere." />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- In-app stats dialog -->
        <Border x:Name="StatsScrim" Classes="dialog-scrim" IsVisible="{Binding IsStatsOpen}"
                PointerPressed="OnStatsScrimPressed">
            <Border Classes="dialog-card" Width="480" MaxWidth="480" MaxHeight="660" Margin="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel Margin="22">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Listening Stats" Classes="dialog-title" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="transport" Width="30" Height="30" Padding="6"
                                Command="{Binding CloseStatsCommand}">
                            <PathIcon Data="{x:Static app:Icons.WindowClose}" Width="11" Height="11" />
                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="StatsScroller">
                        <StackPanel Spacing="18" Margin="0,8,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="TOP SONGS · ALL TIME" Classes="section-header" />
                                <Border Classes="library-locations">
                                    <ItemsControl ItemsSource="{Binding Stats.TopSongsAllTime}"
                                                  ItemTemplate="{StaticResource TopTrackTemplate}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Stats.TopSongsThisMonthLabel}" Classes="section-header" />
                                <Border Classes="library-locations">
                                    <ItemsControl ItemsSource="{Binding Stats.TopSongsThisMonth}"
                                                  ItemTemplate="{StaticResource TopTrackTemplate}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="TOP ARTISTS · ALL TIME" Classes="section-header" />
                                <Border Classes="library-locations">
                                    <ItemsControl ItemsSource="{Binding Stats.TopArtistsAllTime}"
                                                  ItemTemplate="{StaticResource TopArtistTemplate}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Stats.TopArtistsThisMonthLabel}" Classes="section-header" />
                                <Border Classes="library-locations">
                                    <ItemsControl ItemsSource="{Binding Stats.TopArtistsThisMonth}"
                                                  ItemTemplate="{StaticResource TopArtistTemplate}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- In-app generic confirmation dialog, used by anything destructive (currently just
             permanent song deletion) -->
        <Border x:Name="ConfirmScrim" Classes="dialog-scrim" IsVisible="{Binding IsConfirmDialogOpen}"
                PointerPressed="OnConfirmScrimPressed">
            <Border Classes="dialog-card" Width="400" MaxWidth="400" Margin="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="22" Spacing="14">
                    <TextBlock Text="{Binding ConfirmDialogTitle}" Classes="dialog-title" />
                    <TextBlock Text="{Binding ConfirmDialogMessage}" TextWrapping="Wrap" FontSize="12"
                               Foreground="#FF5C5C" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,8,0,0">
                        <Button Grid.Column="1" Classes="playlist-action-btn" Content="Cancel"
                                Command="{Binding CancelConfirmDialogCommand}" />
                        <Button Grid.Column="2" Classes="playlist-action-btn primary"
                                Content="{Binding ConfirmDialogConfirmText}"
                                Command="{Binding AcceptConfirmDialogCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- In-app "what's new" dialog, shown once right after an update -->
        <Border x:Name="WhatsNewScrim" Classes="dialog-scrim" IsVisible="{Binding IsWhatsNewOpen}"
                PointerPressed="OnWhatsNewScrimPressed">
            <Border Classes="dialog-card" Width="440" MaxWidth="440" MaxHeight="520" Margin="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel Margin="22">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="What's New" Classes="dialog-title" />
                            <TextBlock Classes="field-hint">
                                <Run Text="str-amp " /><Run Text="{Binding WhatsNewVersion}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="transport" Width="30" Height="30" Padding="6"
                                Command="{Binding CloseWhatsNewCommand}">
                            <PathIcon Data="{x:Static app:Icons.WindowClose}" Width="11" Height="11" />
                        </Button>
                    </Grid>

                    <Button DockPanel.Dock="Bottom" Classes="playlist-action-btn primary" Content="Got it"
                            Command="{Binding CloseWhatsNewCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />

                    <ScrollViewer>
                        <TextBlock Text="{Binding WhatsNewNotes}" TextWrapping="Wrap" FontSize="12" Opacity="0.85" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- In-app update-available dialog -->
        <Border x:Name="UpdateScrim" Classes="dialog-scrim" IsVisible="{Binding IsUpdateAvailable}"
                PointerPressed="OnUpdateScrimPressed">
            <Border Classes="dialog-card" Width="440" MaxWidth="440" MaxHeight="520" Margin="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel Margin="22">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Update Available" Classes="dialog-title" />
                            <TextBlock Classes="field-hint">
                                <Run Text="str-amp " /><Run Text="{Binding UpdateVersion}" /><Run Text=" is ready to install" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="transport" Width="30" Height="30" Padding="6"
                                Command="{Binding DismissUpdateCommand}" IsEnabled="{Binding !IsDownloadingUpdate}">
                            <PathIcon Data="{x:Static app:Icons.WindowClose}" Width="11" Height="11" />
                        </Button>
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,14,0,0">
                        <TextBlock Text="{Binding UpdateStatusText}" Classes="field-hint"
                                   IsVisible="{Binding IsDownloadingUpdate}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding !IsDownloadingUpdate}">
                            <Button Grid.Column="0" Classes="playlist-action-btn primary" Content="Install &amp; Restart"
                                    Command="{Binding InstallUpdateCommand}" HorizontalAlignment="Left" />
                            <Button Grid.Column="1" Classes="playlist-action-btn" Content="Skip This Version"
                                    Command="{Binding SkipUpdateCommand}" />
                            <Button Grid.Column="2" Classes="playlist-action-btn" Content="Later"
                                    Command="{Binding DismissUpdateCommand}" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer>
                        <TextBlock Text="{Binding UpdateReleaseNotes}" TextWrapping="Wrap" FontSize="12" Opacity="0.85" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- In-app Add to Playlist dialog -->
        <Border x:Name="AddToPlaylistScrim" Classes="dialog-scrim" IsVisible="{Binding IsAddToPlaylistOpen}"
                PointerPressed="OnAddToPlaylistScrimPressed">
            <Border Classes="dialog-card" Width="440" MaxWidth="440" MaxHeight="560" Margin="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel Margin="22">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Add to Playlist" Classes="dialog-title" />
                            <TextBlock Text="Choose a playlist or create a new one" FontSize="11" Opacity="0.55" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="transport" Width="30" Height="30" Padding="6"
                                Command="{Binding CloseAddToPlaylistCommand}" ToolTip.Tip="Close">
                            <PathIcon Data="{x:Static app:Icons.WindowClose}" Width="11" Height="11" />
                        </Button>
                    </Grid>

                    <!-- Song being added preview -->
                    <Border DockPanel.Dock="Top" Classes="playlist-song-preview" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Grid.Column="0" Classes="art-frame" Width="38" Height="38">
                                <Grid>
                                    <PathIcon Data="{x:Static app:Icons.MusicNote}" Width="16" Height="16" Opacity="0.35"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsVisible="{Binding AddToPlaylistSongArt, Converter={StaticResource NullToBool}, ConverterParameter=invert}" />
                                    <Image Source="{Binding AddToPlaylistSongArt}" Stretch="UniformToFill"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                           IsVisible="{Binding AddToPlaylistSongArt, Converter={StaticResource NullToBool}}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding AddToPlaylistSongTitle}" FontWeight="SemiBold" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AddToPlaylistSongArtist}" FontSize="11" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- "Create a new playlist" button at top -->
                    <Button DockPanel.Dock="Top" Classes="create-playlist-btn"
                            IsVisible="{Binding !IsCreatingNewPlaylistInDialog}"
                            Command="{Binding StartCreateNewPlaylistInDialogCommand}"
                            Margin="0,0,0,12" ToolTip.Tip="Create a new playlist with this song">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Grid.Column="0" Classes="create-playlist-icon-frame">
                                <PathIcon Data="{x:Static app:Icons.Add}" Width="14" Height="14"
                                          Foreground="{DynamicResource AppAccentBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Create a new playlist" FontWeight="SemiBold"
                                       VerticalAlignment="Center" FontSize="12" />
                        </Grid>
                    </Button>

                    <!-- Expanded inline creation input -->
                    <Border DockPanel.Dock="Top" Classes="inline-create-box"
                            IsVisible="{Binding IsCreatingNewPlaylistInDialog}"
                            Margin="0,0,0,12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="NEW PLAYLIST" Classes="section-header" Margin="0" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBox x:Name="NewPlaylistTextBox" Grid.Column="0"
                                         Text="{Binding NewPlaylistNameInDialog, Mode=TwoWay}"
                                         PlaceholderText="Playlist name…" Classes="stramp-input"
                                         KeyDown="OnNewPlaylistTextBoxKeyDown" />
                                <Button Grid.Column="1" Classes="playlist-action-btn primary" Content="Create"
                                        Command="{Binding ConfirmCreateNewPlaylistInDialogCommand}" />
                                <Button Grid.Column="2" Classes="playlist-action-btn" Content="Cancel"
                                        Command="{Binding CancelCreateNewPlaylistInDialogCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding NewPlaylistErrorMessage}" Foreground="#FF5C5C" FontSize="11"
                                       IsVisible="{Binding NewPlaylistErrorMessage, Converter={StaticResource NullToBool}}" />
                        </StackPanel>
                    </Border>

                    <!-- List of existing playlists -->
                    <ScrollViewer Classes="library-scroll" MaxHeight="240">
                        <StackPanel Spacing="4">
                            <TextBlock Text="ALL PLAYLISTS" Classes="section-header" Margin="2,0,0,4" />
                            <TextBlock Text="No playlists yet. Create your first playlist above!"
                                       FontSize="12" Opacity="0.5" Margin="4,8"
                                       IsVisible="{Binding HasNoPlaylistsInPicker}" />
                            <ItemsControl ItemsSource="{Binding PlaylistPickerItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlaylistPickerItem">
                                        <Border Classes="playlist-picker-row"
                                                PointerPressed="OnPlaylistPickerItemPointerPressed">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Grid.Column="0" Classes="playlist-picker-icon-frame">
                                                    <PathIcon Data="{x:Static app:Icons.Playlist}" Width="14" Height="14" Opacity="0.75" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CountText}" FontSize="11" Opacity="0.55" />
                                                </StackPanel>
                                                <Border Grid.Column="2" VerticalAlignment="Center">
                                                    <Panel>
                                                        <!-- When already in playlist -->
                                                        <Border Classes="playlist-badge added" IsVisible="{Binding IsAlreadyAdded}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <PathIcon Data="{x:Static app:Icons.Check}" Width="11" Height="11"
                                                                          Foreground="{DynamicResource AppAccentBrush}" />
                                                                <TextBlock Text="Added" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AppAccentBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- When not yet in playlist -->
                                                        <Border Classes="playlist-badge add" IsVisible="{Binding !IsAlreadyAdded}">
                                                            <PathIcon Data="{x:Static app:Icons.Add}" Width="13" Height="13" Opacity="0.6" />
                                                        </Border>
                                                    </Panel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- In-app Create Playlist dialog (standalone) -->
        <Border x:Name="NewPlaylistScrim" Classes="dialog-scrim" IsVisible="{Binding IsNewPlaylistDialogOpen}"
                PointerPressed="OnNewPlaylistScrimPressed">
            <Border Classes="dialog-card" Width="420" MaxWidth="420" Margin="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel Margin="22">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Create Playlist" Classes="dialog-title" />
                            <TextBlock Text="Build a new M3U8 playlist in your library" FontSize="11" Opacity="0.55" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="transport" Width="30" Height="30" Padding="6"
                                Command="{Binding CloseNewPlaylistDialogCommand}" ToolTip.Tip="Close">
                            <PathIcon Data="{x:Static app:Icons.WindowClose}" Width="11" Height="11" />
                        </Button>
                    </Grid>
                    <StackPanel Spacing="12">
                        <TextBox x:Name="StandaloneNewPlaylistTextBox"
                                 Text="{Binding StandaloneNewPlaylistName, Mode=TwoWay}"
                                 PlaceholderText="Playlist name…" Classes="stramp-input"
                                 KeyDown="OnStandaloneNewPlaylistKeyDown" />
                        <TextBlock Text="{Binding StandaloneNewPlaylistError}" Foreground="#FF5C5C" FontSize="11"
                                   IsVisible="{Binding StandaloneNewPlaylistError, Converter={StaticResource NullToBool}}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                            <Button Grid.Column="1" Classes="playlist-action-btn" Content="Cancel"
                                    Command="{Binding CloseNewPlaylistDialogCommand}" />
                            <Button Grid.Column="2" Classes="playlist-action-btn primary" Content="Create Playlist"
                                    Command="{Binding ConfirmStandaloneNewPlaylistCommand}" />
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Border>

        <!-- Transient status toast: fades in on a new message, fades out on its own a few
             seconds later (see MainWindowViewModel's IsStatusVisible). -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18"
                IsHitTestVisible="False"
                Opacity="{Binding IsStatusVisible, Converter={StaticResource FadeOpacity}}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12"
                       TextTrimming="CharacterEllipsis" MaxWidth="360" />
        </Border>
    </Panel>
</Window>
