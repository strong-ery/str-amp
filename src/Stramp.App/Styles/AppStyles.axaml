<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- PathIcon doesn't inherit TextElement.Foreground, so it's invisible against a dark
       background unless given an explicit color. -->
  <Style Selector="PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppIconBrush}" />
  </Style>

  <!-- Title-bar menu: compact trigger, elevated rounded popup, and Stramp hover states. -->
  <Style Selector="Button.top-menu-trigger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.top-menu-trigger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter.stramp-menu-flyout">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="MinWidth" Value="220" />
  </Style>
  <Style Selector="MenuItem.stramp-menu-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="MenuItem.stramp-menu-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="MenuItem.stramp-menu-item PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <!-- Playback-device popup. -->
  <Style Selector="FlyoutPresenter.stramp-device-flyout">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="5" />
  </Style>
  <Style Selector="ListBox.device-picker">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.device-picker ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox.device-picker ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="ListBox.device-picker ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="ListBox.device-picker ListBoxItem:selected PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Flat, icon-only transport buttons (prev/next/shuffle/reshuffle) -->
  <Style Selector="Button.transport">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
  </Style>

  <!-- Shuffle is a plain flat button; "active" just tints the icon instead of filling a pill,
       matching the original's minimal .shuffle-active look rather than a stock toggle chrome. -->
  <Style Selector="Button.transport.active PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <!-- The big centered play/pause button -->
  <Style Selector="Button.play-pause">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.play-pause PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppPlayPauseIconBrush}" />
  </Style>
  <Style Selector="Button.play-pause:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrushLight}" />
  </Style>

  <Style Selector="TextBlock.section-header">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style Selector="Border.now-playing-card">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style Selector="Border.art-frame">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource AppPlaceholderBackgroundBrush}" />
  </Style>

  <Style Selector="Border.art-frame.circular">
    <Setter Property="CornerRadius" Value="9999" />
  </Style>

  <Style Selector="Border.queue-row">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.13" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <!-- Barely-there hover so rows feel alive without adding visual noise. -->
  <Style Selector="ListBox.flat-list ListBoxItem:pointerover Border.queue-row">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="Border.queue-row.playing">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Border.queue-row.playing TextBlock.queue-title">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Library/queue lists: no chrome of their own at all — the only highlight is our own
       Border.queue-row/.playing classes above, applied per-item in the DataTemplate. -->
  <Style Selector="ListBox.flat-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.flat-list ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox.flat-list ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.flat-list ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.flat-list ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.flat-list ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.flat-list ListBoxItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Only the left library/source lists get this narrow, accent-aware scrollbar. -->
  <Style Selector="ListBox.library-scroll ScrollBar:vertical">
    <Setter Property="Width" Value="9" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.library-scroll ScrollBar:vertical /template/ Thumb">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Margin" Value="2,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
  </Style>
  <Style Selector="ListBox.library-scroll ScrollBar:vertical /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrushLight}" />
  </Style>
  <Style Selector="ListBox.library-scroll ScrollBar:vertical /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <!-- Lyrics keep their chrome out of sight until the pointer approaches the right edge. -->
  <Style Selector="ScrollViewer.lyrics-scroll ScrollBar:vertical">
    <Setter Property="Width" Value="8" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollViewer.lyrics-scroll.scrollbar-near ScrollBar:vertical">
    <Setter Property="Opacity" Value="0.72" />
  </Style>
  <Style Selector="ScrollViewer.lyrics-scroll ScrollBar:vertical:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ScrollViewer.lyrics-scroll ScrollBar:vertical /template/ Thumb">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Margin" Value="2,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
  </Style>
  <Style Selector="ScrollViewer.lyrics-scroll ScrollBar:vertical /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrushLight}" />
  </Style>
  <Style Selector="ScrollViewer.lyrics-scroll ScrollBar:vertical /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <!-- Lyrics panel: the line being sung sits in a raised bubble at the middle of the panel and
       everything around it falls back, rather than presenting the sheet as a page to read.
       Font size is set on the list in code (it follows the panel width) and inherited from there. -->
  <Style Selector="Border.lyric-line">
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.34" />
    <!-- Scaled rather than restyled to a larger font: a size change would relayout the list
         underneath the auto-scroll every time the highlight moved. -->
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="RenderTransformOrigin" Value="0%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
        <BrushTransition Property="Background" Duration="0:0:0.3" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.lyric-line TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Already sung: further out of the way than the lines still to come. -->
  <Style Selector="Border.lyric-line.past">
    <Setter Property="Opacity" Value="0.18" />
  </Style>
  <Style Selector="Border.lyric-line.active">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.025,1.045)" />
  </Style>
  <!-- A fullscreen lyric row can use nearly every available pixel. Keep a restrained horizontal
       lift so it still pops without scaling wrapped text through the clipping edge. -->
  <Style Selector="ScrollViewer.lyrics-scroll.immersive Border.lyric-line.active">
    <Setter Property="RenderTransform" Value="scale(1.015,1.045)" />
  </Style>
  <Style Selector="Border.lyric-line.active TextBlock">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <!-- Unsynced files have no highlight to carry the reading, so every line stays legible. -->
  <Style Selector="Border.lyric-line.plain">
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Border.lyric-line:not(.plain)">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- Excludes the active line, whose own bubble would otherwise be replaced by the hover tint. -->
  <Style Selector="Border.lyric-line:not(.plain):not(.active):pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- Custom window chrome -->
  <Style Selector="Button.window-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.window-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="Button.window-button.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E81123" />
  </Style>
  <Style Selector="Button.window-button.close:pointerover PathIcon">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.window-button PathIcon">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <!-- In-app dialog -->
  <Style Selector="Border.dialog-scrim">
    <Setter Property="Background" Value="#B0000000" />
  </Style>
  <Style Selector="Border.dialog-card">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="0 18 50 0 #90000000" />
  </Style>
  <Style Selector="TextBlock.dialog-title">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="TextBlock.field-hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.swatch">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
  </Style>

  <!-- The editable centre frequency under each EQ slider: sized to fit "16000" in a 44px column. -->
  <Style Selector="TextBox.band-frequency">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="42" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="TextBox.band-frequency:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="TextBox.band-frequency:focus">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Border.eq-panel">
    <Setter Property="Background" Value="{DynamicResource AppPlaceholderBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,12" />
  </Style>

  <Style Selector="Border.library-locations">
    <Setter Property="Background" Value="{DynamicResource AppPlaceholderBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="Border.library-location-row">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="8,7" />
  </Style>
  <Style Selector="Border.library-location-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>

  <Style Selector="Border.library-location-icon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.add-library-location">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Button.preset">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="7,5" />
  </Style>
  <Style Selector="Button.preset:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>

</Styles>
