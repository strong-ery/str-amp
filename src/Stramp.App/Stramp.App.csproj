<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Stramp.ico</ApplicationIcon>
    <Product>str-amp</Product>
    <Company>Dylan Strong, Aiden Adzich, and Contributors</Company>
    <Authors>Dylan Strong, Aiden Adzich, and Contributors</Authors>
    <Copyright>Copyright © 2025 Dylan Strong and Aiden Adzich</Copyright>
  </PropertyGroup>

  <!--
    The self-contained/single-file settings that make a release a single exe live ONLY in
    publish.ps1's command line (as -p: overrides), never here. A `Condition="...Configuration...
    == 'Release'"` PropertyGroup looks like it would be publish-only but isn't: `dotnet build -c
    Release` and `dotnet run -c Release` pick it up too, producing a self-contained BUILD (every
    runtime DLL loose on disk, createdump.exe and all) without the single-file step that was the
    entire point, since that step only runs during an actual publish. Keeping these out of the
    csproj entirely is what actually scopes them to publish.ps1's `dotnet publish` invocation.
  -->

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <None Update="Assets\Stramp.ico"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />

    <!-- Shipped alongside the exe so the "what's new" popup can read it without a network call. -->
    <None Include="..\..\CHANGELOG.md" Link="CHANGELOG.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stramp.Core\Stramp.Core.csproj" />
    <ProjectReference Include="..\Stramp.Audio\Stramp.Audio.csproj" />
    <ProjectReference Include="..\Stramp.Integrations.Windows\Stramp.Integrations.Windows.csproj" />
  </ItemGroup>
</Project>
